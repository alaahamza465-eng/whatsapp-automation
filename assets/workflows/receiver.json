  {
   "id": "4d10a31e-5c0a-43d7-a059-6c16aac661b8",
   "name": "Parse Events",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    -1888,
    -288
   ],
   "parameters": {
    "jsCode": "// تفكيك أحداث واتساب: حالات الرسائل + ردود الناس + نتائج مراجعة الرسائل\nconst S = {};\nfor (const it of $('Read Settings P').all()) { const r = it.json; if (r.key) S[String(r.key).trim()] = r.value; }\nconst OUR_PHONE = String(S.phone_number_id || '').trim(); // رقم الحملة (من الإعدادات العامة)\nconst OUR_WABA = String(S.waba_id || '').trim(); // حساب واتساب للأعمال (لموافقات الرسائل)\nconst out = [];\nfor (const it of $('WhatsApp Events (POST)').all()) {\n  const body = it.json.body || it.json;\n  for (const e of (body.entry || [])) {\n    for (const ch of (e.changes || [])) {\n      if (ch.field === 'message_template_status_update' && String(e.id || '') === OUR_WABA) {\n        const t = ch.value || {};\n        if (t.message_template_id) out.push({ json: { kind: 'tpl', template_id: String(t.message_template_id), status: String(t.event || '').toUpperCase(),\n          reason: String(t.reason || '') === 'NONE' ? '' : String(t.reason || '') } });\n        continue;\n      }\n      if (ch.field !== 'messages') continue;\n      const v = ch.value || {};\n      if (String((v.metadata || {}).phone_number_id || '') !== OUR_PHONE) continue; // حدث مش من رقمنا: بنتجاهله\n      for (const s of (v.statuses || [])) {\n        const er = (s.errors && s.errors[0]) || {};\n        out.push({ json: { kind: 'status', wamid: s.id, status: s.status, recipient: s.recipient_id || '', ts: Number(s.timestamp) || 0,\n          error_code: er.code || '', error_title: er.title || er.message || '' } });\n      }\n      for (const m of (v.messages || [])) {\n        let text = '', payload = '';\n        if (m.type === 'text') text = (m.text && m.text.body) || '';\n        else if (m.type === 'button') { text = (m.button && m.button.text) || ''; payload = (m.button && m.button.payload) || ''; }\n        else if (m.type === 'interactive') {\n          const r = (m.interactive && (m.interactive.button_reply || m.interactive.list_reply)) || {};\n          text = r.title || ''; payload = r.id || '';\n        } else { const md = m[m.type] || {}; text = '[' + m.type + ']' + (md.caption ? ' ' + md.caption : (md.filename ? ' ' + md.filename : '')); }\n        const prof = ((v.contacts || []).find(x => x.wa_id === m.from) || (v.contacts || [])[0] || {}).profile || {};\n        out.push({ json: { kind: 'message', from: String(m.from || ''), text, payload, id: String(m.id || ''), ts: Number(m.timestamp) || 0, profile: String(prof.name || '') } });\n      }\n    }\n  }\n}\nreturn out;\n"
   }
  },
