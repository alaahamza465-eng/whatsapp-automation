   "parameters": {
    "jsCode": "// تأكيد ربط الـ Webhook مع Meta\n// غيّر هاد النص، وحط نفس النص بخانة Verify token بإعدادات تطبيق Meta\nconst VERIFY_TOKEN = '__VERIFY_TOKEN__';\nconst q = ($json.query) || {};\nconst ok = q['hub.mode'] === 'subscribe' && q['hub.verify_token'] === VERIFY_TOKEN;\nreturn { json: { ok, body: ok ? String(q['hub.challenge'] || '') : 'forbidden', code: ok ? 200 : 403 } };\n",
    "mode": "runOnceForEachItem"
   }
