   ],
   "parameters": {
    "jsCode": "// إشعار لما واتساب يوافق أو يرفض رسالة حملة\nlet names = {};\ntry { for (const it of $('Read Campaigns R').all()) { const c = it.json; if (c.cid) names[String(c.cid)] = String(c.name || ''); } } catch (e) {}\nconst WHY = { INVALID_FORMAT: 'صيغة الرسالة مش مقبولة', TAG_CONTENT_MISMATCH: 'نوع الرسالة مش مطابق', SCAM: 'اعتبرها مشبوهة', ABUSIVE_CONTENT: 'اعتبرها مخالفة', PROMOTIONAL: 'اعتبرها إعلان زيادة' };\nconst out = [];\nfor (const it of $input.all()) {\n  const m = it.json;\n  const st = String(m.status || '').toUpperCase();\n  if (!['APPROVED', 'REJECTED', 'PAUSED', 'DISABLED'].includes(st)) continue;\n  const nm = names[String(m.campaign || '')] || 'حملة';\n  const ver = m.slot ? ` (النسخة ${m.slot})` : '';\n  const ok = st === 'APPROVED';\n  out.push({ json: { kind: 'tpl', key: 'tpl-' + String(m.template_id || ''),\n    title: ok ? `✅ واتساب وافق على رسالة «${nm}»` : `❌ واتساب ${st === 'REJECTED' ? 'رفض' : 'وقّف'} رسالة «${nm}»`,\n    body: ok ? `الرسالة${ver} جاهزة. إذا الحملة شغّالة بتبلش تبعت لحالها.` : `الرسالة${ver}: ${WHY[m.reason] || m.reason || 'بدون سبب'}. اكتب نسخة جديدة.`,\n    link: 'camp=' + String(m.campaign || ''), wa_text: '' } });\n}\nreturn out;\n"
   }
  },
