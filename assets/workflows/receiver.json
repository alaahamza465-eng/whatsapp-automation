  {
   "id": "769bd222-5f93-4843-9d10-4799f65dba8b",
   "name": "Log Auto Reply",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    128,
    -144
   ],
   "parameters": {
    "jsCode": "// تسجيل الرد التلقائي بصندوق المحادثات\nconst stamp = $now.setZone('__TIMEZONE__').toFormat('yyyy-MM-dd HH:mm:ss');\nconst src = $('Build Reply').all();\nconst out = [];\n$input.all().forEach((it, i) => {\n  const sj = (src[i] || {}).json || {};\n  const p = sj.payload || {};\n  if (!p.to) return;\n  const ok = !!(it.json.messages && it.json.messages[0]);\n  out.push({ json: { wa_id: String(p.to).replace(/\\D/g, ''), name: '', dir: 'out', kind: 'auto',\n    text: String((p.text || {}).body || '').slice(0, 4000), at: stamp,\n    wamid: ok ? String(it.json.messages[0].id) : 'fail-' + Date.now() + '-' + i, status: ok ? 'sent' : 'failed', seen: '1', campaign: String(sj.campaign || '') } });\n});\nreturn out;\n"
   }
  },
