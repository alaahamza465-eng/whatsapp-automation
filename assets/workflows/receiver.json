  {
   "id": "c72064ef-71c7-4694-8de9-8409646cb143",
   "name": "Map Status",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    -1424,
    -560
   ],
   "parameters": {
    "jsCode": "// تحويل حالة الرسالة (وصلت / انقرت / فشلت) لسطر بالجدول، مع وقتها\nconst S = {};\nfor (const it of $('Read Settings P').all()) { const r = it.json; if (r.key) S[String(r.key).trim()] = r.value; }\nconst num = (v, d) => { const n = Number(v); return (v === '' || v === null || v === undefined || isNaN(n)) ? d : n; };\nconst now = $now.setZone('__TIMEZONE__');\nconst primary = String(S.primary_cc || '').replace(/\\D/g, '');\nconst PS = primary === '970' || primary === '972'; // بس بفلسطين في مفتاح ثاني نجربه\nconst out = [];\nfor (const it of $input.all()) {\n  const s = it.json;\n  if (!s.wamid || s.status === 'sent') continue; // \"sent\" مسجلة من الإرسال\n  const t = Number(s.ts) ? DateTime.fromSeconds(Number(s.ts)).setZone('__TIMEZONE__') : now;\n  const at = t.toFormat('yyyy-MM-dd HH:mm');\n  const o = { wamid: String(s.wamid), st: s.status, at, updated_at: now.toFormat('yyyy-MM-dd HH:mm'), error_code: String(s.error_code || ''), retry_after: '', notes: '' };\n  if (s.status === 'failed') {\n    const code = Number(s.error_code);\n    o.notes = String(s.error_title || '').slice(0, 250);\n    if (code === 131026) o.delivery = PS && String(s.recipient || '').startsWith(primary) ? 'retry_alt' : 'no_whatsapp'; // جرّب المفتاح الثاني قبل ما نحكم إنه ما عنده واتساب\n    else if (code === 131049) { // حد ميتا لرسائل التسويق لكل شخص: ميتا بتطلب نستنى 24 ساعة على الأقل، وإلا بيتسكر أكتر\n      o.delivery = 'retry_later';\n      o.retry_after = now.plus({ hours: Math.max(24, num(S.cap_retry_hours, 25)) }).toFormat('yyyy-MM-dd HH:mm');\n    } else if ([130472, 130429, 131056].includes(code)) {\n      o.delivery = 'retry_later';\n      o.retry_after = now.plus({ days: num(S.retry_days, 3) }).toFormat('yyyy-MM-dd');\n    } else o.delivery = 'failed';\n  } else if (s.status === 'delivered' || s.status === 'read') {\n    o.delivery = s.status;\n  } else continue;\n  out.push({ json: o });\n}\nreturn out;\n"
   }
  },
  {
   "id": "2ed21a7e-6921-4994-b6aa-d908b57258d3",
   "name": "Classify",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    -976,
    -144
   ],
   "parameters": {
    "jsCode": "// تصنيف رد الشخص (مهتم / مش مهتم / رد عادي) وتحديد أي حملة بيرد عليها\nconst last9 = p => String(p || '').replace(/\\D/g, '').slice(-9);\nconst S = {};\nfor (const it of $('Read Settings P').all()) { const r = it.json; if (r.key) S[String(r.key).trim()] = r.value; }\nconst words = (v, d) => String(v ?? d).split(/[,،\\n]+/).map(w => w.trim().toLowerCase()).filter(Boolean);\nconst YES = words(S.yes_words, 'نعم,اه,آه,ايوا,أيوا,ايوه,بدي,اكيد,أكيد,تمام,بدي التفاصيل');\nconst NO = words(S.stop_words, 'مش مهتم,مو مهتم,غير مهتم,لا شكرا,الغاء,إلغاء,توقف,stop');\nconst camps = {};\nfor (const it of $('Read Campaigns R').all()) { const c = it.json; if (c.cid) camps[String(c.cid)] = c; }\nconst by9 = new Map();\nfor (const it of $('Read Contacts R').all()) {\n  const c = it.json;\n  for (const k of new Set([last9(c.phone), last9(c.wa_id)])) {\n    if (!k) continue;\n    if (!by9.has(k)) by9.set(k, new Map());\n    by9.get(k).set(c.id, c);\n  }\n}\nconst stamp = $now.setZone('__TIMEZONE__').toFormat('yyyy-MM-dd HH:mm');\nconst out = [];\nfor (const it of $('Parse Events').all()) {\n  const m = it.json;\n  if (m.kind !== 'message' || !m.from) continue;\n  const rows = [...((by9.get(last9(m.from)) || new Map()).values())];\n  if (!rows.length) continue; // مش من القائمة: تنبيهه بيطلع من صندوق المحادثات\n  const raw = String(m.payload || '').trim();\n  const [pk, pc] = raw.split('|');\n  const latest = rows.slice().sort((a, b) => String(b.sent_at || '').localeCompare(String(a.sent_at || '')))[0];\n  let row = pc ? rows.find(r => String(r.campaign || '') === pc) : null;\n  let cid = row ? String(row.campaign || '') : (pc && camps[pc] ? pc : String(latest.campaign || ''));\n  if (!row) row = (pc && camps[pc]) ? { ...latest, response: '' } : latest; // رسالة تجربة لحملة ما فيها الرقم\n  const t = String(m.text || '').trim();\n  const p = String(pk || '').toUpperCase();\n  let response = 'replied';\n  const tl = t.toLowerCase();\n  const starts = w => tl === w || (tl.startsWith(w) && !/[\\u0600-\\u06FFa-z0-9]/i.test(tl.charAt(w.length))); // كلمة كاملة بأول الرد\n  if (p === 'INTERESTED' || YES.some(starts)) response = 'interested';\n  if (p === 'STOP' || NO.some(w => tl.includes(w)) || /^لا[\\s.!]*$/.test(t)) response = 'opted_out';\n  const prev = String(row.response || '').trim();\n  if (response === 'replied' && (prev === 'interested' || prev === 'opted_out')) response = prev; // ما بننزّل الحالة\n  out.push({ json: {\n    phone: String(row.phone || ''),\n    campaign: cid,\n    campaign_name: String((camps[cid] || {}).name || ''),\n    name: String(row.name || ''),\n    kind: raw ? 'button' : 'text',\n    wa_id: String(m.from),\n    response,\n    reply: t.slice(0, 300),\n    updated_at: stamp,\n    last_in_at: stamp, // كتبلنا: نافذة 24 ساعة انفتحت، فرسائلنا بتوصله أكيد\n    auto_reply: prev !== response && (response === 'interested' || response === 'opted_out')\n  } });\n}\nreturn out;\n"
   }
  },
