  {
   "id": "bf1ec0b4-16a9-47f5-b0a2-f091d0e0e427",
   "name": "Build Reply",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    -320,
    -144
   ],
   "parameters": {
    "jsCode": "// الرد التلقائي لكل حملة (مجاني لأنه جوا نافذة الـ24 ساعة بعد رد الشخص)\nconst S = {};\nfor (const it of $('Read Settings').all()) { const r = it.json; if (r.key) S[String(r.key).trim()] = r.value; }\nconst camps = {};\nfor (const it of $('Read Campaigns R').all()) { const c = it.json; if (c.cid) camps[String(c.cid)] = c; }\nconst v = String(S.api_version || 'v23.0').trim();\nconst id = String(S.phone_number_id || '').trim();\nconst out = [];\nfor (const it of $('Classify').all()) {\n  const c = it.json;\n  if (!c.auto_reply || !id) continue;\n  const cp = camps[c.campaign] || {};\n  const text = c.response === 'interested' ? (cp.interested_reply || S.interested_reply) : (cp.optout_reply || S.optout_reply);\n  if (!String(text || '').trim()) continue;\n  out.push({ json: { campaign: c.campaign, url: `https://graph.facebook.com/${v}/${id}/messages`,\n    payload: { messaging_product: 'whatsapp', to: String(c.wa_id), type: 'text', text: { body: String(text) } } } });\n}\nreturn out;\n"
   }
  },
