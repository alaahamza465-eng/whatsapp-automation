    "jsCode": "// إشعار لكل رسالة بتوصلنا من الناس (على تلفونك من البرنامج، وعلى واتساب إذا مشغّل)\nconst S = {};\nfor (const it of $('Read Settings P').all()) { const r = it.json; if (r.key) S[String(r.key).trim()] = r.value; }\nconst last9 = p => String(p || '').replace(/\\D/g, '').slice(-9);\nconst camps = {};\nfor (const it of $('Read Campaigns U').all()) { const c = it.json; if (c.cid) camps[String(c.cid)] = String(c.name || ''); }\nconst people = new Map();\nfor (const it of $('Read Contacts U').all()) {\n  const c = it.json;\n  for (const k of new Set([last9(c.wa_id), last9(c.phone)])) { if (!k) continue; if (!people.has(k)) people.set(k, []); people.get(k).push(c); }\n}\nconst pay = {};\nfor (const it of $('Parse Events').all()) { const m = it.json; if (m.kind === 'message') pay[String(m.id)] = String(m.payload || ''); }\nconst mine = new Set(String(S.alert_numbers || '').split(/[,\\s]+/).map(x => last9(x)).filter(x => x.length === 9));\nconst out = [];\nfor (const it of $('Chat In').all()) {\n  const m = it.json;\n  const wa = String(m.wa_id || '');\n  const rows = people.get(last9(wa)) || [];\n  const latest = rows.slice().sort((a, b) => String(b.sent_at || '').localeCompare(String(a.sent_at || '')))[0];\n  const name = String((rows.find(r => String(r.name || '').trim()) || {}).name || '').trim() || String(m.name || '').trim();\n  const who = name || ('+' + wa);\n  const [pk, pc] = String(pay[String(m.wamid || '')] || '').split('|');\n  const cid = pc && camps[pc] !== undefined ? pc : String((latest || {}).campaign || '');\n  const camp = camps[cid] ? `حملة «${camps[cid]}»` : '';\n  const text = String(m.text || '').replace(/\\s+/g, ' ').trim();\n  let kind = 'msg', title = `💬 ${who}`, body = text, wa_text = '';\n  const P = String(pk || '').toUpperCase();\n  if (P === 'INTERESTED') { kind = 'lead'; title = `🙋 ${who} بده التفاصيل`; body = camp ? `كبس «${text || 'بدي التفاصيل'}» · ${camp}` : `كبس «${text || 'بدي التفاصيل'}»`;\n    wa_text = `شخص جديد مهتم${camp ? ' (' + camp + ')' : ''}: ${who} (+${wa}). وصله الرد التلقائي`; }\n  else if (P === 'STOP') { kind = 'stop'; title = `🚫 ${who} مش مهتم`; body = camp || 'كبس «مش مهتم»'; }\n  else {\n    if (!rows.length) title = `💬 رقم جديد: ${who}`;\n    wa_text = rows.length ? `رسالة جديدة${camp ? ' (' + camp + ')' : ''} من ${who} (+${wa}): ${text}` : `رسالة من رقم مش بالقائمة: ${who} (+${wa}): ${text}`;\n  }\n  out.push({ json: { kind, key: 'wa-' + wa, throttle: kind === 'msg', self: mine.has(last9(wa)), title: title.slice(0, 120), body: body.slice(0, 250),\n    link: 'chat=' + wa, wa_text: wa_text.replace(/\\s+/g, ' ').slice(0, 900) } });\n}\nreturn out;\n"
   }
  },
